[Unit]
Description=Local Streamer (StreamMark) - Docker Compose stack
Documentation=https://github.com/sAyaN24/local-streamer
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=__INSTALL_DIR__/infra
ExecStart=__DOCKER_BIN__ compose -f docker-compose.yml --env-file .env up -d --remove-orphans
ExecStop=__DOCKER_BIN__ compose -f docker-compose.yml down
ExecReload=__DOCKER_BIN__ compose -f docker-compose.yml up -d --remove-orphans
# Generous headroom for a cold start: pulling livekit/mongo/nginx base images
# plus the api/frontend/proxy images (pull_policy: always re-checks GHCR on
# every start, not just the first) and working through the health-gated
# startup chain (livekit+mongo -> api -> frontend -> proxy) can take a while
# on a slow network or an under-powered box.
TimeoutStartSec=600
TimeoutStopSec=60

[Install]
WantedBy=multi-user.target
