[Unit]
Description=Local Streamer (StreamMark) - Docker Compose stack
Documentation=https://github.com/sAyaN24/local-streamer
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=__INSTALL_DIR__/infra
ExecStart=__DOCKER_BIN__ compose -f docker-compose.yml --env-file .env up -d --remove-orphans
ExecStop=__DOCKER_BIN__ compose -f docker-compose.yml down
ExecReload=__DOCKER_BIN__ compose -f docker-compose.yml up -d --remove-orphans
TimeoutStartSec=300
TimeoutStopSec=60

[Install]
WantedBy=multi-user.target
