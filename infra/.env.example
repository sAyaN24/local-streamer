# Copy this file to infra/.env and fill in real secrets before running
# `docker compose up` (see infra/README.md). The orchestration scripts under
# infra/scripts/ also read/rewrite this file directly.
#
# These variables are consumed by streammark_shared.config.Settings, which is
# shared by both backend-webserver (api, MongoDB, app-auth vars) and
# stream-publisher (LiveKit, capture, ingest-resilience vars) -- see shared/.

# --- LiveKit ---
LIVEKIT_URL=ws://192.168.0.101:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret-please-change-before-deploy

# --- Capture (ingest) ---
CAPTURE_DEVICE=/dev/video0
CAPTURE_FOURCC=MJPG
VIDEO_WIDTH=1920
VIDEO_HEIGHT=1080
VIDEO_FPS=60
VIDEO_BITRATE_KBPS=8000
VIDEO_CODEC=h264
SIMULCAST_ENABLED=false
DEFAULT_ROOM_NAME=shared-stream

# --- Rooms ---
ROOM_EMPTY_TIMEOUT_SEC=300
ROOM_DEPARTURE_TIMEOUT_SEC=20
ROOM_MAX_PARTICIPANTS=60

# --- Tokens (LiveKit) ---
VIEWER_TOKEN_TTL_MINUTES=360
PUBLISHER_TOKEN_TTL_MINUTES=720

# --- MongoDB ---
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=streammark

# --- App-level auth (separate secret from LiveKit's) ---
AUTH_JWT_SECRET=devauthsecret-please-change-before-deploy
AUTH_TOKEN_TTL_MINUTES=1440

# --- API service ---
API_HOST=0.0.0.0
API_PORT=8000
CORS_ALLOW_ORIGINS=*
LOG_LEVEL=INFO

# --- Frontend ---
# Optional escape hatch, read at container start (not build time). Leave
# unset: the frontend then defaults to same-origin /api/, which is correct
# when accessed through the proxy service (see docker/proxy.conf and
# docker-compose.yml) -- no LAN IP needs to be known here at all. Only set
# this if the API is genuinely hosted somewhere other than this same origin.
#VITE_API_BASE_URL=

# --- Ingest resilience ---
INGEST_RECONNECT_INITIAL_BACKOFF_SEC=0.5
INGEST_RECONNECT_MAX_BACKOFF_SEC=10.0
INGEST_CAPTURE_REOPEN_INTERVAL_SEC=2.0
INGEST_CAPTURE_MAX_CONSECUTIVE_READ_FAILURES=30
METRICS_LOG_INTERVAL_SEC=5.0
