# Copy this file to ".env" next to the streammark-publisher executable and
# fill in the values for the machine hosting the Docker stack (infra/.env on
# that box has the same LIVEKIT_URL/KEY/SECRET). Leave CAPTURE_DEVICE unset --
# the executable always auto-detects the capture card on startup; pass
# --device <path/index> only if auto-detection picks the wrong one.

# --- LiveKit (must match the Docker stack's infra/.env) ---
LIVEKIT_URL=ws://192.168.0.101:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret-please-change-before-deploy

# --- Room to publish into ---
DEFAULT_ROOM_NAME=demo-room

# --- Video profile (optional -- defaults shown) ---
#VIDEO_WIDTH=1920
#VIDEO_HEIGHT=1080
#VIDEO_FPS=60
#VIDEO_BITRATE_KBPS=8000

LOG_LEVEL=INFO
